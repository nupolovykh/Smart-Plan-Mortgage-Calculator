# Smart Plan Mortgage Calculator - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Database path (relative to the backend/ directory)
DB_PATH=database.sqlite

# CORS allowed origins (comma-separated). Use * for development only.
# Required: if unset, the API fails closed to a localhost-only default and logs
# a warning rather than allowing '*' — see backend/src/api.php.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# PHP built-in server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Rate limiting for POST /api/integrations/sendForm (per-IP sliding window).
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
